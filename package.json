{
  "name": "SYNERGY | Ivanti MCP",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "version:sync": "node scripts/check-version.mjs --sync",
    "version:check": "node scripts/check-version.mjs --check",
    "check:examples": "node scripts/check-example-envs.mjs",
    "check:licenses": "node scripts/check-license-headers.mjs && node scripts/third-party-notices.mjs --check",
    "licenses": "node scripts/third-party-notices.mjs",
    "check:docker": "node scripts/check-docker-context.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "fast-xml-parser": "^5.11.1",
    "jose": "^6.1.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "license": "LicenseRef-SYNERGY-Commercial",
  "author": "SYNERGY (https://www.synergy.eu)"
}
