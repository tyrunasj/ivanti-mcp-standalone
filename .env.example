# ─────────────────────────────────────────────────────────────────────────────
#  Ivanti MCP (standalone) — configuration reference
# ─────────────────────────────────────────────────────────────────────────────
#
#  Copy to `.env` for local development:      cp .env.example .env
#
#  How it is loaded
#    pnpm dev / pnpm start   read `.env` automatically (node --env-file-if-exists)
#    docker                  docker run --env-file .env …   /   compose `env_file:`
#    production              real environment variables; `.env` is a dev convenience
#
#  Two rules that apply throughout
#    1. The server FAILS CLOSED. An incomplete configuration exits 78 (EX_CONFIG)
#       and prints every problem at once, not just the first.
#    2. Any secret may instead be supplied as a file with the `_FILE` suffix, e.g.
#       BEARER_TOKEN_FILE=/run/secrets/bearer-token. Setting both forms is an error,
#       not a precedence question. Prefer the file form in containers so secrets
#       never appear in `docker inspect`.
#
# ─────────────────────────────────────────────────────────────────────────────


# ═══ 1. Transport and door ═══════════════════════════════════════════════════
#
#   Two independent axes. MCP_TRANSPORT is *how the server is reached*; AUTH_MODE
#   is *who may connect*. Neither is the identity of the person an operation is
#   for — that is the Customer field on the Ivanti record.

# Transports are independent toggles, so one can be flipped without restating the
#   other — which is how layered env config (compose overrides, k8s) gets edited.
#   Both may be on at once; at least one must be.

# STDIO_TRANSPORT_ON — default: true
#   stdin/stdout, for desktop clients and `docker run -i`. Listens on no socket,
#   which is why it is on by default. AUTH_MODE does not apply: the credential is
#   the ability to run the process, and the spec agrees ("Implementations using an
#   STDIO transport SHOULD NOT follow this specification, and instead retrieve
#   credentials from the environment").
#
#   Turn this OFF for an HTTP-only container. Left on with no stdin attached, the
#   transport simply sees EOF — harmless, but it is noise you do not need.
STDIO_TRANSPORT_ON=true

# HTTP_TRANSPORT_ON — default: false
#   Streamable HTTP. Requires AUTH_MODE, MCP_PUBLIC_URL and TRUSTED_ORIGINS.
HTTP_TRANSPORT_ON=false

# AUTH_MODE — none | bearer | oauth.  REQUIRED when HTTP_TRANSPORT_ON=true, and
#   REJECTED when it is false, where it would only give a false sense of
#   protection.
#
#   none     No authentication. The network is the boundary. Binds 127.0.0.1
#            unless MCP_BIND says otherwise — see below.
#   bearer   A static token. Not spec-blessed, but what CI, scripts and
#            enterprise connectors actually support.
#   oauth    OAuth 2.1 resource server. The only door that carries a verified
#            user identity. Never mints tokens.
#
#   No default: serving on a socket demands an explicit decision.
# AUTH_MODE=bearer


# ═══ 2. Audience ═════════════════════════════════════════════════════════════

# MCP_MODE — which tools exist. Chosen at startup; never mix audiences in one
#   instance.
#
#   full      IT staff. Every Business Object, every operation, production
#             included. The client harness plus tool annotations are the guardrail.
#   enduser   Employees. May create only the Business Objects listed in
#             ENDUSER_BUSINESS_OBJECTS, and edit only their own records.
#
#   Default: full
MCP_MODE=full

# ENDUSER_BUSINESS_OBJECTS — comma-separated, REQUIRED when MCP_MODE=enduser.
#   Use the TECHNICAL Business Object names (what list_business_objects returns and
#   what the REST API accepts), never display names — those are customizable and
#   localizable per tenant, so a rename would silently empty the allowlist.
#   Validated at startup; an unknown name refuses to start.
# ENDUSER_BUSINESS_OBJECTS=Incident,ChangeRequest,ServiceReq


# ═══ 3. HTTP transport (HTTP_TRANSPORT_ON=true) ══════════════════════════════

# MCP_PUBLIC_URL — REQUIRED for every HTTP mode. The externally visible URL.
#   Never derived from the request: behind Traefik or nginx the Host header and
#   scheme are rewritten, but the RFC 9728 metadata document and the OAuth token
#   audience must match this string EXACTLY.
#
#   Must be a canonical resource URI (RFC 8707): absolute, no fragment, no
#   trailing slash. Checked at startup — a stray "/" causes an audience mismatch
#   that looks like a client bug.
#
#   Valid:   https://mcp.example.com/mcp   https://mcp.example.com:8443
#   Invalid: mcp.example.com   https://mcp.example.com/   https://x.com/mcp#frag
# MCP_PUBLIC_URL=https://mcp.example.com/mcp

# MCP_BIND — interface to listen on. Default: 127.0.0.1
#   Loopback by default so that exposing the server to a network is a second,
#   deliberate act. With AUTH_MODE=none this is the difference between "no auth on
#   my machine" and "no auth on the corporate LAN" — set it knowingly.
# MCP_BIND=0.0.0.0

# MCP_PORT — default: 3000
# MCP_PORT=3000

# TRUSTED_ORIGINS — comma-separated, REQUIRED for every HTTP mode.
#   Origin validation is mandatory: an invalid Origin gets 403. It is what stops
#   DNS rebinding, where a page the user merely visits drives this server from
#   inside the network. A request with no Origin header is allowed — non-browser
#   clients send none.
# TRUSTED_ORIGINS=https://claude.ai,https://chatgpt.com


# --- Session lifetime (HTTP only) -------------------------------------------
#
#   Each client that calls `initialize` gets its own session, keyed by the
#   Mcp-Session-Id header, with its own transport and MCP server instance. Both
#   limits below are load-bearing, not decoration.

# MCP_SESSION_IDLE_TTL_SECONDS — default: 1800 (30 minutes)
#   A session with no traffic for this long is closed and swept.
#
#   Why it is not optional: the SDK's `onsessionclosed` callback fires only when a
#   client sends an explicit DELETE, and clients routinely vanish without one —
#   a crashed process, a closed laptop, a dropped network. Without a TTL those
#   sessions accumulate forever.
#
#   Raise it if clients idle between tool calls for long stretches; the cost is
#   memory held for sessions that may never return.
MCP_SESSION_IDLE_TTL_SECONDS=1800

# MCP_MAX_SESSIONS — default: 100
#   Ceiling on concurrent sessions. Beyond it, `initialize` is refused with
#   HTTP 503 rather than the process growing without bound.
#
#   Why it is not optional: with AUTH_MODE=none anything that can reach the port
#   can call `initialize` indefinitely, which is a denial-of-service surface
#   rather than merely a leak. It matters less with bearer or oauth, where the
#   caller must already be through the door — but the ceiling costs nothing.
#
#   Sizing: one session ≈ one transport + one MCP server instance. A handful of
#   clients needs single digits; 100 is a generous default, not a target.
MCP_MAX_SESSIONS=100


# ═══ 4. AUTH_MODE=bearer ═════════════════════════════════════════════════════

# BEARER_TOKEN — REQUIRED in bearer mode. Compared in constant time.
#   Size the token's audience to the tool surface behind it: a token handed to a
#   multi-user client (an enterprise workspace connector) grants that surface to
#   EVERYONE who can use the connector. Pair a widely-shared token with
#   MCP_MODE=enduser.
# BEARER_TOKEN=change-me
# BEARER_TOKEN_FILE=/run/secrets/bearer-token


# ═══ 5. AUTH_MODE=oauth ══════════════════════════════════════════════════════

# OAUTH_ISSUER — REQUIRED in oauth mode. Validated exactly against the token's
#   `iss`. Authorization-server metadata is discovered from it once at startup, so
#   a wrong issuer fails at boot rather than as a puzzling 401 later.
#
#   Zitadel: https://your-instance.zitadel.cloud
#   Entra:   https://login.microsoftonline.com/<tenant-id>/v2.0
#            (v2 — pin `requestedAccessTokenVersion: 2` in the app registration.
#             v1 issues https://sts.windows.net/<tenant-id>/ instead.)
# OAUTH_ISSUER=https://your-instance.zitadel.cloud

# OAUTH_AUDIENCE — the value the token must name in `aud`.
#   Defaults to MCP_PUBLIC_URL, which is what the spec assumes — but NO mainstream
#   IdP mints the audience from the client's RFC 8707 `resource` parameter, so in
#   practice this almost always needs setting:
#
#     Zitadel   a numeric project id. The client adds it via the scope
#               urn:zitadel:iam:org:project:id:<projectId>:aud
#     Entra     the Application ID URI, e.g. api://ivanti-mcp
#     Keycloak  typically the client id
#
#   Validation is membership in `aud`, which may be an array.
# OAUTH_AUDIENCE=api://ivanti-mcp

# OAUTH_JWKS_URI — optional. Skips discovery entirely when set. Use it when the
#   IdP does not publish metadata where the spec's probe order looks.
# OAUTH_JWKS_URI=https://your-instance.zitadel.cloud/oauth/v2/keys

# OAUTH_SCOPES_SUPPORTED — comma-separated. Advertised in the Protected Resource
#   Metadata document as the minimal set for basic functionality.
#   `offline_access` is stripped automatically: refresh tokens are a client
#   concern, not a resource requirement.
# OAUTH_SCOPES_SUPPORTED=openid,profile,ivanti:read

# OAUTH_REQUIRED_SCOPES — comma-separated. Missing any of these yields 403 with
#   error="insufficient_scope" and a WWW-Authenticate challenge naming what to
#   request. Leave empty to require only a valid token.
# OAUTH_REQUIRED_SCOPES=ivanti:read


# ═══ 6. Ivanti ═══════════════════════════════════════════════════════════════
#   Not yet read by the server — the Ivanti client lands in Stage B1. Listed here
#   so the shape is settled.
#
#   One instance serves exactly ONE tenant: staging, UAT and prod are three
#   containers, not three tenants in one process.
#
#   One API key belonging to ONE Ivanti "MCP user". Every operation executes as
#   that user, like a call-centre operator; the person it is *for* is recorded in
#   the record's Customer field.

# IVANTI_BASE_URL=https://your-tenant.ivanticloud.com
# IVANTI_API_KEY_FILE=/run/secrets/ivanti-api-key


# ═══ 7. Logging ══════════════════════════════════════════════════════════════

# LOG_LEVEL — debug | info | warn | error. Default: info
#   Structured JSON, always to stderr — stdout carries the JSON-RPC stream under
#   the stdio transport and must never be written to.
LOG_LEVEL=info
