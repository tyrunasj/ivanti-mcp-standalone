# ═════════════════════════════════════════════════════════════════════════════
#  Ivanti MCP (standalone) — configuration reference
# ═════════════════════════════════════════════════════════════════════════════
#
#  Copy to `.env` for local development:   cp .env.example .env
#
#  Loading
#    pnpm dev / pnpm start   read `.env` automatically (node --env-file-if-exists)
#    docker                  docker run --env-file .env …  /  compose `env_file:`
#    production              real environment variables; `.env` is a dev convenience
#    Inline shell vars WIN over `.env`:  AUTH_MODE=none pnpm start
#
#  Two rules that apply throughout
#    1. The server FAILS CLOSED. An incomplete configuration exits 78 (EX_CONFIG)
#       and prints every problem at once, not just the first.
#    2. Any secret may be supplied as a file with the `_FILE` suffix, e.g.
#       BEARER_TOKEN_FILE=/run/secrets/bearer-token. Setting both forms is an
#       error, not a precedence question. Prefer the file form in containers so
#       secrets never appear in `docker inspect`.
#
#  Sections follow the order you actually decide things:
#    1. Quick start   2. Transport   3. Access   4. Capability
#    5. Ivanti        6. Operations
#
# ═════════════════════════════════════════════════════════════════════════════


# ═══ 1. Quick start ══════════════════════════════════════════════════════════
#
#  Local desktop client (Claude Desktop, `docker run -i`) — this is the default,
#  and needs nothing else at all:
#     STDIO_TRANSPORT_ON=true
#
#  Internal HTTP service with a shared token:
#     STDIO_TRANSPORT_ON=false
#     HTTP_TRANSPORT_ON=true
#     AUTH_MODE=bearer
#     BEARER_TOKEN_FILE=/run/secrets/bearer-token
#     MCP_PUBLIC_URL=https://mcp.example.com/mcp
#     TRUSTED_ORIGINS=https://claude.ai
#
#  Enterprise SSO:
#     STDIO_TRANSPORT_ON=false
#     HTTP_TRANSPORT_ON=true
#     AUTH_MODE=oauth
#     MCP_PUBLIC_URL=https://mcp.example.com/mcp
#     TRUSTED_ORIGINS=https://claude.ai
#     OAUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#     OAUTH_AUDIENCE=api://ivanti-mcp


# ═══ 2. Transport — how the server is reached ════════════════════════════════
#
#  Two independent toggles, so one can be flipped without restating the other —
#  which is how layered env config (compose overrides, k8s) gets edited. Both may
#  be on at once; at least one must be.

# STDIO_TRANSPORT_ON — default: true
#   stdin/stdout, for desktop clients and `docker run -i`. Listens on no socket,
#   which is why it is on by default. AUTH_MODE does not apply: the credential is
#   the ability to run the process, and the spec agrees ("Implementations using an
#   STDIO transport SHOULD NOT follow this specification, and instead retrieve
#   credentials from the environment").
#
#   Turn OFF for an HTTP-only container. Left on with no stdin attached the
#   transport simply sees EOF — harmless, but noise you do not need.
STDIO_TRANSPORT_ON=true

# HTTP_TRANSPORT_ON — default: false
#   Streamable HTTP. Requires AUTH_MODE, MCP_PUBLIC_URL and TRUSTED_ORIGINS.
HTTP_TRANSPORT_ON=false

# --- The rest of this section applies only when HTTP_TRANSPORT_ON=true -------

# MCP_PUBLIC_URL — REQUIRED for HTTP. The externally visible URL.
#   Never derived from the request: behind Traefik or nginx the Host header and
#   scheme are rewritten, but the RFC 9728 metadata document and the OAuth token
#   audience must match this string EXACTLY.
#
#   Must be a canonical resource URI (RFC 8707): absolute, no fragment, no
#   trailing slash — checked at startup, because a stray "/" causes an audience
#   mismatch that looks like a client bug.
#
#   Valid:   https://mcp.example.com/mcp   https://mcp.example.com:8443
#   Invalid: mcp.example.com   https://mcp.example.com/   https://x.com/mcp#frag
# MCP_PUBLIC_URL=https://mcp.example.com/mcp

# TRUSTED_ORIGINS — REQUIRED for HTTP. Comma-separated.
#   Origin validation is mandatory: an invalid Origin gets 403. It is what stops
#   DNS rebinding, where a page the user merely visits drives this server from
#   inside the network. A request with no Origin header is allowed — non-browser
#   clients (including Claude Code) send none.
# TRUSTED_ORIGINS=https://claude.ai,https://chatgpt.com

# MCP_BIND — default: 127.0.0.1
#   Loopback by default so exposing the server to a network is a second,
#   deliberate act. With AUTH_MODE=none this is the difference between "no auth
#   on my machine" and "no auth on the corporate LAN" — set it knowingly.
# MCP_BIND=0.0.0.0

# MCP_PORT — default: 3000
# MCP_PORT=3000


# ═══ 3. Access — who may connect ═════════════════════════════════════════════
#
#  AUTH_MODE is the door. It is NOT the identity of the person an operation is
#  *for* — that is the Customer field on the Ivanti record.

# AUTH_MODE — none | bearer | oauth
#   REQUIRED when HTTP_TRANSPORT_ON=true, and REJECTED when it is false, where it
#   would only give a false sense of protection. No default: serving on a socket
#   demands an explicit decision.
#
#   none     No authentication. The network is the boundary.
#   bearer   A static token. Not spec-blessed, but what CI, scripts and
#            enterprise connectors actually support.
#   oauth    OAuth 2.1 resource server. The only door carrying a verified user
#            identity. Never mints tokens.
# AUTH_MODE=bearer

# --- AUTH_MODE=bearer --------------------------------------------------------

# BEARER_TOKEN — REQUIRED in bearer mode. Compared in constant time.
#   Size the token's audience to the tool surface behind it: a token handed to a
#   multi-user client (an enterprise workspace connector) grants that surface to
#   EVERYONE who can use the connector. Pair a widely-shared token with
#   MCP_MODE=enduser.
# BEARER_TOKEN=change-me
# BEARER_TOKEN_FILE=/run/secrets/bearer-token

# --- AUTH_MODE=oauth ---------------------------------------------------------

# OAUTH_ISSUER — REQUIRED in oauth mode. Validated exactly against the token's
#   `iss`. Authorization-server metadata is discovered from it once at startup,
#   so a wrong issuer fails at boot rather than as a puzzling 401 later.
#
#   Entra:   https://login.microsoftonline.com/<tenant-id>/v2.0
#            (v2 — pin `requestedAccessTokenVersion: 2` in the app registration;
#             v1 issues https://sts.windows.net/<tenant-id>/ instead)
#   Zitadel: https://your-instance.zitadel.cloud
#   Okta:    use a CUSTOM authorization server; the org one issues opaque tokens
# OAUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# OAUTH_AUDIENCE — comma-separated list of accepted `aud` values.
#   A token is accepted when its `aud` contains ANY of these, and the token's own
#   `aud` may itself be an array — so this is a set intersection, not equality. A
#   list because a deployment routinely has more than one legitimate client.
#
#   Defaults to MCP_PUBLIC_URL, which is what the spec assumes — but NO mainstream
#   IdP mints the audience from the client's RFC 8707 `resource` parameter, so in
#   practice this almost always needs setting:
#
#     Entra     the Application ID URI, e.g. api://ivanti-mcp
#     Zitadel   a numeric project or client id
#     Keycloak  typically the client id
# OAUTH_AUDIENCE=api://ivanti-mcp
# OAUTH_AUDIENCE=390160165095211844,390161459490980676   # several clients

# OAUTH_JWKS_URI — optional. Skips discovery entirely when set. Use it when the
#   IdP does not publish metadata where the spec's probe order looks.
# OAUTH_JWKS_URI=https://your-instance.example/oauth/v2/keys

# OAUTH_SCOPES_SUPPORTED — comma-separated. Advertised in the Protected Resource
#   Metadata document as the minimal set for basic functionality.
#   `offline_access` is stripped automatically: refresh tokens are a client
#   concern, not a resource requirement.
# OAUTH_SCOPES_SUPPORTED=openid,profile

# OAUTH_REQUIRED_SCOPES — comma-separated. Missing any of these yields 403 with
#   error="insufficient_scope" and a challenge naming what to request. Leave empty
#   to require only a valid token.
# OAUTH_REQUIRED_SCOPES=


# ═══ 4. Capability — what a caller may do ════════════════════════════════════

# MCP_MODE — full | enduser.  Default: full
#   Chosen at startup; never mix audiences in one instance.
#
#   full      IT staff. Every Business Object, every operation, production
#             included. The client harness plus tool annotations are the guardrail.
#   enduser   Employees. May create only the Business Objects listed below, and
#             edit only their own records.
MCP_MODE=full

# ENDUSER_BUSINESS_OBJECTS — comma-separated. REQUIRED when MCP_MODE=enduser.
#   Use the TECHNICAL Business Object names (what list_business_objects returns
#   and what the REST API accepts), never display names — those are customizable
#   and localizable per tenant, so a rename would silently empty the allowlist.
#   Validated at startup; an unknown name refuses to start.
# ENDUSER_BUSINESS_OBJECTS=Incident,ChangeRequest,ServiceReq


# ═══ 5. Ivanti ═══════════════════════════════════════════════════════════════
#   Not yet read by the server — the Ivanti client lands in Stage B1. Listed so
#   the shape is settled.
#
#   One instance serves exactly ONE tenant: staging, UAT and prod are three
#   containers, not three tenants in one process.
#
#   One API key belonging to ONE Ivanti "MCP user". Every operation executes as
#   that user, like a call-centre operator; the person it is *for* is recorded in
#   the record's Customer field.

# IVANTI_BASE_URL=https://your-tenant.ivanticloud.com
# IVANTI_API_KEY_FILE=/run/secrets/ivanti-api-key


# ═══ 6. Operations ═══════════════════════════════════════════════════════════

# MCP_SESSION_IDLE_TTL_SECONDS — default: 1800 (30 minutes)  [HTTP only]
#   A session with no traffic for this long is closed and swept.
#
#   Not optional: the SDK's `onsessionclosed` fires only on an explicit DELETE,
#   and clients routinely vanish without one — a crashed process, a closed laptop,
#   a cleared authentication. Observed live, not theoretical. Without a TTL those
#   sessions accumulate forever.
MCP_SESSION_IDLE_TTL_SECONDS=1800

# MCP_MAX_SESSIONS — default: 100  [HTTP only]
#   Ceiling on concurrent sessions; beyond it `initialize` is refused with 503.
#   With AUTH_MODE=none anything that reaches the port can call `initialize`
#   indefinitely, which is a denial-of-service surface rather than merely a leak.
#   Sizing: ~100 KB per session, so the default costs roughly 10 MB.
MCP_MAX_SESSIONS=100

# LOG_LEVEL — debug | info | warn | error.  Default: info
#   Structured JSON, always to stderr — stdout carries the JSON-RPC stream under
#   the stdio transport and must never be written to.
#   `debug` adds one line per MCP request: method, tool, session and the
#   authenticated subject. Arguments are never logged.
LOG_LEVEL=info
