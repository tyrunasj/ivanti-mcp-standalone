# ═════════════════════════════════════════════════════════════════════════════
#  Ivanti MCP (standalone) — configuration reference
# ═════════════════════════════════════════════════════════════════════════════
#
#  Copy to `.env` for local development:   cp .env.example .env
#
#  Loading
#    pnpm dev / pnpm start   read `.env` automatically (node --env-file-if-exists)
#    docker                  docker run --env-file .env …  /  compose `env_file:`
#    production              real environment variables; `.env` is a dev convenience
#    Inline shell vars WIN over `.env`:  AUTH_MODE=none pnpm start
#
#  Two rules that apply throughout
#    1. The server FAILS CLOSED. An incomplete configuration exits 78 (EX_CONFIG)
#       and prints every problem at once, not just the first.
#    2. Any secret may be supplied as a file with the `_FILE` suffix, e.g.
#       BEARER_TOKEN_FILE=/run/secrets/bearer-token. Setting both forms is an
#       error, not a precedence question. Prefer the file form in containers so
#       secrets never appear in `docker inspect`.
#
#  Sections follow the order you actually decide things:
#    1. Quick start   2. Transport   3. Access   4. Capability
#    5. Ivanti        6. Operations  7. Metrics
#
# ═════════════════════════════════════════════════════════════════════════════


# ═══ 1. Quick start ══════════════════════════════════════════════════════════
#
#  Local desktop client (Claude Desktop, `docker run -i`) — this is the default,
#  and needs nothing else at all:
#     STDIO_TRANSPORT_ON=true
#
#  Local development over HTTP, no authentication:
#     STDIO_TRANSPORT_ON=false
#     HTTP_TRANSPORT_ON=true
#     AUTH_MODE=none
#     MCP_BIND=127.0.0.1                      # <- keep loopback; see the warning below
#     MCP_PUBLIC_URL=http://127.0.0.1:3000/mcp
#     TRUSTED_ORIGINS=http://localhost
#
#  Internal HTTP service with a shared token:
#     STDIO_TRANSPORT_ON=false
#     HTTP_TRANSPORT_ON=true
#     AUTH_MODE=bearer
#     BEARER_TOKEN_FILE=/run/secrets/bearer-token
#     MCP_PUBLIC_URL=https://mcp.example.com/mcp
#     TRUSTED_ORIGINS=https://claude.ai
#
#  Enterprise SSO:
#     STDIO_TRANSPORT_ON=false
#     HTTP_TRANSPORT_ON=true
#     AUTH_MODE=oauth
#     MCP_PUBLIC_URL=https://mcp.example.com/mcp
#     TRUSTED_ORIGINS=https://claude.ai
#     OAUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#     OAUTH_AUDIENCE=api://ivanti-mcp


# ═══ 2. Transport — how the server is reached ════════════════════════════════
#
#  Two independent toggles, so one can be flipped without restating the other —
#  which is how layered env config (compose overrides, k8s) gets edited. Both may
#  be on at once; at least one must be.

# STDIO_TRANSPORT_ON — default: true
#   stdin/stdout, for desktop clients and `docker run -i`. Listens on no socket,
#   which is why it is on by default. AUTH_MODE does not apply: the credential is
#   the ability to run the process, and the spec agrees ("Implementations using an
#   STDIO transport SHOULD NOT follow this specification, and instead retrieve
#   credentials from the environment").
#
#   Turn OFF for an HTTP-only container. Left on with no stdin attached the
#   transport simply sees EOF — harmless, but noise you do not need.
STDIO_TRANSPORT_ON=true

# HTTP_TRANSPORT_ON — default: false
#   Streamable HTTP. Requires AUTH_MODE, MCP_PUBLIC_URL and TRUSTED_ORIGINS.
HTTP_TRANSPORT_ON=false

# --- The rest of this section applies only when HTTP_TRANSPORT_ON=true -------

# MCP_PUBLIC_URL — REQUIRED for HTTP. The externally visible URL.
#   Never derived from the request: behind Traefik or nginx the Host header and
#   scheme are rewritten, but the RFC 9728 metadata document and the OAuth token
#   audience must match this string EXACTLY.
#
#   Must be a canonical resource URI (RFC 8707): absolute, no fragment, no
#   trailing slash — checked at startup, because a stray "/" causes an audience
#   mismatch that looks like a client bug.
#
#   Valid:   https://mcp.example.com/mcp   https://mcp.example.com:8443
#   Invalid: mcp.example.com   https://mcp.example.com/   https://x.com/mcp#frag
# MCP_PUBLIC_URL=https://mcp.example.com/mcp

# TRUSTED_ORIGINS — REQUIRED for HTTP. Comma-separated.
#   Origin validation is mandatory: an invalid Origin gets 403. It is what stops
#   DNS rebinding, where a page the user merely visits drives this server from
#   inside the network. A request with no Origin header is allowed — non-browser
#   clients (including Claude Code) send none.
# TRUSTED_ORIGINS=https://claude.ai,https://chatgpt.com

# MCP_BIND — default: 127.0.0.1
#   Loopback by default so exposing the server to a network is a second,
#   deliberate act. With AUTH_MODE=none this is the difference between "no auth
#   on my machine" and "no auth on the corporate LAN" — set it knowingly.
# MCP_BIND=0.0.0.0

# MCP_PORT — default: 3000
# MCP_PORT=3000


# ═══ 3. Access — who may connect ═════════════════════════════════════════════
#
#  AUTH_MODE is the door. It is NOT the identity of the person an operation is
#  *for* — that is the Customer field on the Ivanti record.

# AUTH_MODE — none | bearer | oauth
#   REQUIRED when HTTP_TRANSPORT_ON=true, and REJECTED when it is false, where it
#   would only give a false sense of protection. No default: serving on a socket
#   demands an explicit decision.
#
#   none     No authentication. The network is the boundary.
#
#            Only pair this with MCP_BIND=127.0.0.1 unless you genuinely mean to
#            serve an unauthenticated MCP server to everything that can route to
#            you. If a reverse proxy or tunnel publishes this host, `none` plus a
#            non-loopback bind puts the whole tool surface on the internet — the
#            server warns at startup but will not stop you.
#
#            Note it also unlocks the detailed /health payload, since detail is
#            gated on the same authorization as everything else and in this mode
#            every caller passes.
#   bearer   A static token. Not spec-blessed, but what CI, scripts and
#            enterprise connectors actually support.
#   oauth    OAuth 2.1 resource server. The only door carrying a verified user
#            identity. Never mints tokens.
# AUTH_MODE=bearer

# --- AUTH_MODE=bearer --------------------------------------------------------

# BEARER_TOKEN — REQUIRED in bearer mode. Compared in constant time.
#   At least 32 characters; anything shorter refuses to start. Generate one:
#     openssl rand -base64 32
#   Size the token's audience to the tool surface behind it: a token handed to a
#   multi-user client (an enterprise workspace connector) grants that surface to
#   EVERYONE who can use the connector. Pair a widely-shared token with
#   MCP_MODE=enduser.
# BEARER_TOKEN=<output of openssl rand -base64 32>
# BEARER_TOKEN_FILE=/run/secrets/bearer-token

# --- AUTH_MODE=oauth ---------------------------------------------------------

# OAUTH_ISSUER — REQUIRED in oauth mode. Validated exactly against the token's
#   `iss`. Authorization-server metadata is discovered from it once at startup,
#   so a wrong issuer fails at boot rather than as a puzzling 401 later.
#   https:// only (plain http is accepted for a loopback host alone), and the
#   same for OAUTH_JWKS_URI: over http anyone on the path could swap the keys a
#   token is checked against.
#
#   Entra:   https://login.microsoftonline.com/<tenant-id>/v2.0
#            (v2 — pin `requestedAccessTokenVersion: 2` in the app registration;
#             v1 issues https://sts.windows.net/<tenant-id>/ instead)
#   Zitadel: https://your-instance.zitadel.cloud
#   Okta:    use a CUSTOM authorization server; the org one issues opaque tokens
# OAUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# OAUTH_AUDIENCE — comma-separated list of accepted `aud` values.
#   A token is accepted when its `aud` contains ANY of these, and the token's own
#   `aud` may itself be an array — so this is a set intersection, not equality. A
#   list because a deployment routinely has more than one legitimate client.
#
#   Defaults to MCP_PUBLIC_URL, which is what the spec assumes — but NO mainstream
#   IdP mints the audience from the client's RFC 8707 `resource` parameter, so in
#   practice this almost always needs setting:
#
#     Entra     the Application ID URI, e.g. api://ivanti-mcp
#     Zitadel   a numeric project or client id
#     Keycloak  typically the client id
# OAUTH_AUDIENCE=api://ivanti-mcp
# OAUTH_AUDIENCE=390160165095211844,390161459490980676   # several clients

# OAUTH_JWKS_URI — optional. Skips discovery entirely when set. Use it when the
#   IdP does not publish metadata where the spec's probe order looks.
# OAUTH_JWKS_URI=https://your-instance.example/oauth/v2/keys

# OAUTH_SCOPES_SUPPORTED — comma-separated. Advertised in the Protected Resource
#   Metadata document as the minimal set for basic functionality.
#   `offline_access` is stripped automatically: refresh tokens are a client
#   concern, not a resource requirement.
# OAUTH_SCOPES_SUPPORTED=openid,profile

# OAUTH_REQUIRED_SCOPES — comma-separated. Missing any of these yields 403 with
#   error="insufficient_scope" and a challenge naming what to request. Leave empty
#   to require only a valid token.
# OAUTH_REQUIRED_SCOPES=

# OAUTH_IDENTITY_CLAIM — which claim names the person, for matching against the
#   Ivanti employee directory. Default: `email` only when the token also carries
#   `email_verified: true`, then `preferred_username`, then `upn`. When set, the
#   claim is used as-is — so it must be an immutable, admin-controlled claim that
#   users cannot edit in their IdP profile; otherwise a user can set it to a
#   colleague's value and be signed in, and impersonated, as them.
#
#   NOT `sub`. That identifies the token's subject, and Entra's is an opaque
#   pairwise identifier that appears nowhere in a customer's directory. Set this
#   when the provider puts the human-readable identifier somewhere else.
# OAUTH_IDENTITY_CLAIM=preferred_username


# ═══ 4. Capability — what a caller may do ════════════════════════════════════

# MCP_MODE — full | enduser.  Default: full
#   Chosen at startup; never mix audiences in one instance.
#
#   full      IT staff. Every Business Object, every operation, production
#             included. The client harness plus tool annotations are the guardrail.
#   enduser   Employees. May create only the Business Objects listed below, and
#             read or edit only their own records.
#
#   In enduser mode NOTHING returns a record until `act_as` has resolved the
#   person being helped to an Ivanti employee or external contact — reads are
#   narrowed to that person, a record belonging to anyone else is refused, and a
#   new record is stamped with them. In full mode `act_as` gates nothing: it only
#   decides who "my tickets" means, which otherwise answers for the service
#   account this server signs in as.
#
#   Any ENDUSER_* setting below, set while the mode is full, REFUSES TO START:
#   full ignores them all, so an employee deployment that forgot to flip the
#   mode would otherwise serve employees the whole IT-staff surface.
MCP_MODE=full

# ENDUSER_BUSINESS_OBJECTS — comma-separated. REQUIRED when MCP_MODE=enduser.
#   Use the TECHNICAL Business Object names (what list_business_objects returns
#   and what the REST API accepts), never display names — those are customizable
#   and localizable per tenant, so a rename would silently empty the allowlist.
#   Any of Ivanti's three dialects is accepted and normalised on load:
#   `Incident#`, `Incidents` and `incident` all name the same object.
#
#   THIS IS THE GATE, not a hint. In enduser mode every tool refuses any other
#   object: the catalog lists only these, the cross-object search covers only
#   these, assigned work reports only these, and an attachment is refused when
#   the record it hangs off is not one of them. Each name is resolved against
#   the tenant at startup, so a misspelling exits 78 rather than quietly
#   narrowing what an end user may do.
#   Validated at startup; an unknown name refuses to start.
# ENDUSER_BUSINESS_OBJECTS=Incident,Change,ServiceReq

# ENDUSER_QUICK_ACTIONS — comma-separated action NAMES, as Ivanti shows them.
#   Only meaningful when MCP_MODE=enduser. Empty (the default) means end users
#   run no quick actions at all.
#
#   A quick action is the tenant's own procedure — closing, reopening,
#   cancelling — and running one is more correct than writing a status, which
#   skips whatever that procedure does. But Ivanti scopes the action list by
#   role and this server signs in as ONE account: on an admin key a stock
#   incident offers 104 of them, including escalation notifications and
#   analyst-only composites. So name the handful an end user should have.
#
#   The names are yours, not Ivanti's — a tenant renames them freely, which is
#   why the server will not guess from the wording. Read them off
#   list_quick_actions in full mode and copy the ones you want.
#
#   Whatever is listed is still only runnable on the caller's OWN record, and
#   never on a closed one.
# ENDUSER_QUICK_ACTIONS=Close From Self Service,Reopen Incident (Self Service)


# ═══ 5. Ivanti ═══════════════════════════════════════════════════════════════
#   Optional today: without them the server starts and serves only the
#   transport-level tools, and says so in the startup log. Set them together —
#   one without the other refuses to start, because a half-configured connection
#   would look healthy and fail on the first Ivanti call.
#
#   One instance serves exactly ONE tenant: staging, UAT and prod are three
#   containers, not three tenants in one process.
#
#   One API key belonging to ONE Ivanti "MCP user". Every operation executes as
#   that user, like a call-centre operator; the person it is *for* is recorded in
#   the record's Customer field.

# IVANTI_BASE_URL — the tenant origin, no path. Whether this tenant serves the
#   API under /HEAT or at the root is PROBED at startup, not configured: both are
#   tried against $metadata and whichever answers with a CSDL document wins. The
#   result is in the `ivanti reachable` log line. A tenant that answers neither
#   fails the startup rather than deferring the error to the first tool call.
#   https:// only — the API key travels with every request. Plain http is
#   accepted for a loopback host alone (a local mock, a port-forward); the same
#   rule applies to IVANTI_CONFIG_URL.
# IVANTI_BASE_URL=https://your-tenant.ivanticloud.com

# IVANTI_API_KEY / IVANTI_API_KEY_FILE — exactly one of the two, like the bearer
#   token. The key needs no admin rights: what it can reach is probed at startup
#   and narrows the tool list rather than failing at call time.
#     odata    the key alone          every read tool; ~194 objects from metadata
#     session  the ASMX handshake     + the identity, workspaces, picklist values
#     admin    the admin console      + the complete catalog (1324 objects)
# IVANTI_API_KEY_FILE=/run/secrets/ivanti-api-key

# IVANTI_MAX_TIER — odata | session | admin. Default: use whatever the key can do.
#   Caps the server at a lower tier than the credential allows. This exists
#   because there is no other way to see what a customer without admin rights
#   gets: AuthenticateTenantAPIKey's `role` argument is ignored — an admin
#   account asked for SelfService still answers Admin — so the degraded paths
#   cannot be exercised by asking for a lesser role.
# IVANTI_MAX_TIER=session

# IVANTI_TIMEOUT_MS — default: 10000. How long a read may wait for Ivanti: every
#   OData/REST GET, `$metadata`, and the startup probe.
# IVANTI_WRITE_TIMEOUT_MS — default: 30000. Everything else — creates, updates,
#   deletes, links, uploads — and the whole ASMX session (forms, pick lists,
#   quick actions), which POSTs whether it reads or writes, and CentralConfig.
#
#   Separate because a create runs the tenant's workflow before it answers, and
#   on workflow-heavy objects that takes longer than a read ever should. A write
#   cut off is the costliest failure there is: it may have been applied, so the
#   caller is told to check before retrying rather than file it twice. Raise the
#   write timeout if `no answer within 30000 ms` shows up on writes that did
#   take effect.
#
#   Both in 1000–300000, and the write timeout may not be the shorter of the
#   two; anything else refuses to start.
# IVANTI_TIMEOUT_MS=10000
# IVANTI_WRITE_TIMEOUT_MS=30000

# IVANTI_MAX_CONCURRENT_REQUESTS — default: 16. Range 1–256.
#   How many requests this process may have in flight to the tenant at once,
#   across every conversation. Past it a request waits its turn — as long as its
#   own timeout — and one still waiting then fails as NEVER SENT (a write is not
#   reported as "may have been applied", because it was not). The tenant is the
#   ceiling, not this server; raise it only if the tenant has room.
# IVANTI_MAX_CONCURRENT_REQUESTS=16

# Egress proxy and corporate CAs — Node settings, not this server's. Node's
#   fetch IGNORES HTTPS_PROXY unless NODE_USE_ENV_PROXY=1 is set as well, and a
#   TLS-intercepting proxy needs its root CA in NODE_EXTRA_CA_CERTS. See
#   docs/configuration.md, "Reaching Ivanti through a proxy".
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.corp.example:3128
# NO_PROXY=localhost,127.0.0.1
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/corp-root-ca.pem

# IVANTI_CONFIG_URL + IVANTI_CENTRAL_CONFIG_API_KEY — impersonation. OPTIONAL,
#   and valid only as a pair. With neither, the server behaves exactly as it
#   does today: act_as decides who "my" means and every call still reaches
#   Ivanti as this service account.
#
#   With both, act_as additionally opens an Ivanti session AS that person, and
#   Ivanti applies their own access to it — a self-service role reads none of
#   the incidents an analyst reads. Records they create are stamped with their
#   name rather than this account's.
#
#   Every surface follows: records, forms, pick lists, quick actions, service
#   requests and their attachments all run as the person. Only tenant-wide facts
#   (the schema, the admin catalog, the person directory) stay on the service
#   account, because they describe the tenant rather than the person.
#
#   The key comes from the ConfigDB tenant: Configure → Security Controls →
#   API Keys → the CentralConfigApiKey group. It is NOT the tenant API key.
#   Guard it accordingly — CentralConfig answers it with the tenant's database
#   credentials among other things.
# IVANTI_CONFIG_URL=https://config-your-tenant.example.com
# IVANTI_CENTRAL_CONFIG_API_KEY_FILE=/run/secrets/ivanti-central-config-key

# IVANTI_IMPERSONATION_ROLE — MCP_MODE=full only. Default: keep whichever
#   non-self-service role Ivanti made active for that person.
#   Pins the role an impersonated session opens under. It is used when the
#   person holds it and refused when they do not, never silently ignored.
# IVANTI_IMPERSONATION_ROLE=ServiceDeskAnalyst

# ENDUSER_ROLE — MCP_MODE=enduser only. Default: SelfServiceMobile
#   The role an impersonated end-user session opens under. Ivanti flags its
#   self-service roles, but several qualify and they are not interchangeable,
#   so this names the one. Resolved per person when `act_as` runs, NOT at startup: a role this
#   tenant does not use is reported in that call's `roleNote`, and the session keeps whichever
#   role Ivanti made active. Unlike ENDUSER_BUSINESS_OBJECTS, a wrong name here does not
#   refuse the boot.
# ENDUSER_ROLE=SelfServiceMobile


# ═══ 6. Operations ═══════════════════════════════════════════════════════════

# MCP_SESSION_IDLE_TTL_SECONDS — default: 1800 (30 minutes)  [HTTP only]
#   A session with no traffic for this long is closed and swept.
#
#   Not optional: the SDK's `onsessionclosed` fires only on an explicit DELETE,
#   and clients routinely vanish without one — a crashed process, a closed laptop,
#   a cleared authentication. Observed live, not theoretical. Without a TTL those
#   sessions accumulate forever.
MCP_SESSION_IDLE_TTL_SECONDS=1800

# MCP_IDENTITY_IDLE_TTL_SECONDS — default: 1800 (30 minutes)  [both transports]
#   A conversation with no tool call for this long is over: the pinned person is
#   forgotten, any Ivanti session opened for them is handed back, and `act_as` must
#   be called again before anything answers.
#
#   Deliberately NOT the session TTL above, which it borrowed for one release. That
#   one bounds memory held by a dead HTTP session and wants to be short; this one
#   decides how long a person's records stay reachable to whoever is at the keyboard.
#
#   It matters most on stdio, where there is no session to sweep — one process is one
#   connection for its whole life, so this is the only thing that ends a conversation
#   at all. Without it a client that keeps the server running across conversations
#   (the ordinary shape for an editor or a CLI) carried the first person's pin into
#   every conversation that followed.
#
#   Bias it short. Expiring too eagerly costs one more `act_as`; expiring too late
#   answers the next conversation with the last person's records.
MCP_IDENTITY_IDLE_TTL_SECONDS=1800

# MCP_MAX_SESSIONS — default: 100  [HTTP only]
#   Ceiling on concurrent sessions. At it, a new `initialize` closes the least
#   recently used session that has had no traffic for 60 s and nothing in flight
#   (clients routinely abandon sessions without a DELETE); only when every session
#   is busy is it refused with 503, whose Retry-After says when one could free.
#   With AUTH_MODE=none anything that reaches the port can call `initialize`
#   indefinitely, which is a denial-of-service surface rather than merely a leak.
#   Sizing: measured ~64 KiB per held session above ~104 MiB idle (Linux) — the
#   default 100 is lost in garbage-collection noise, 1,000 adds ~63 MiB.
MCP_MAX_SESSIONS=100

# MCP_MAX_SESSIONS_PER_SUBJECT — default: unset (no limit)  [HTTP, AUTH_MODE=oauth only]
#   How many sessions one signed-in person may hold. Past it their own least
#   recently used session is closed rather than the new one refused. Refused at
#   startup under none or bearer, where every caller is the same anonymous subject,
#   and above MCP_MAX_SESSIONS, where it could never apply.
# MCP_MAX_SESSIONS_PER_SUBJECT=5

# MCP_MAX_CALLS_PER_MINUTE — default: 120. Range 1–10000.
#   Tool calls one conversation may make in a minute; past it a call is refused
#   with how long to wait. Stops a model in a loop, or a client replaying one,
#   before it reaches the tenant. A person's conversations are bounded too under
#   oauth, by MCP_MAX_SESSIONS_PER_SUBJECT.
# MCP_MAX_CALLS_PER_MINUTE=120

# IVANTI_IMPERSONATION_REQUIRED — default: false  [needs the IVANTI_CONFIG_URL pair]
#   Off, a ConfigDB that does not answer at startup is a warning, and `act_as`
#   then only decides who "my" means while the service account reads. On, the
#   server exits 78 instead of running as the service account. Refused at startup
#   when the impersonation pair is not configured.
# IVANTI_IMPERSONATION_REQUIRED=true

# LOG_LEVEL — debug | info | warn | error.  Default: info
#   Structured JSON, always to stderr — stdout carries the JSON-RPC stream under
#   the stdio transport and must never be written to.
#   `info`  lifecycle, one audit line and one usage line (sizes, outcome — never
#           content; see `pnpm usage:report`) per tool call, writes, identity;
#           warn when Ivanti is unreachable (timeout, 5xx) or refuses the key (401);
#           error only for faults in this server, with the stack.
#   `debug` adds one line per MCP request (method, tool, session, subject) and one
#           per Ivanti request: method, path, the QUERY, field names of a write,
#           status, duration — and the scrubbed error body when it fails.
#   `debug` CONTAINS PERSONAL DATA: a `$filter` routinely names a person. Turn it
#   on to diagnose, not as a standing setting in production. Tool arguments and
#   the values of a write are never logged, at any level.
LOG_LEVEL=info


# ═══ 7. Metrics — Prometheus, on a port of its own ══════════════════════════
#
#  OFF by default. An internet-facing deployment should leave it off unless
#  something private scrapes it: METRICS_ON=false is the whole of turning it off.
#
#  Never the MCP port. Every credential that guards the MCP port reaches the
#  tools — under `none` nothing guards it, under `bearer` the scraper would hold
#  the token that calls delete_record, under `oauth` it would need a signed-in
#  person — and whatever fronts the MCP port (an ingress, a tunnel, a TLS proxy)
#  must never route to the metrics.
#
#  What is served: tool names and outcomes, Ivanti request methods and statuses,
#  timings, sessions, memory. Never a person, a filter, a record or ticket text —
#  but error rates by tool still say what a deployment is used for, hence
#  loopback by default and an optional token.
#
#  The listener answers GET (and HEAD) /metrics only: 404 elsewhere, 405 for
#  other methods, 403 for anything a browser sends (an Origin or Sec-Fetch-Site
#  header — this is what stops DNS rebinding from a web page), and 401 when a
#  token is set and missing or wrong.

# METRICS_ON — default: false
#   Off, there is no metrics listener at all, and the other METRICS_* settings
#   are ignored rather than refused — so flipping this one toggle is all it takes.
# METRICS_ON=true

# METRICS_BIND — default: 127.0.0.1
#   Loopback by default, like MCP_BIND: exposing metrics is a separate,
#   deliberate act. Inside a container or pod it must be 0.0.0.0 — loopback
#   there is the container's own — and the published address or a NetworkPolicy
#   then decides who reaches it. Bound beyond loopback with no token, the server
#   warns at startup (`metrics listen beyond this machine with no token`).
# METRICS_BIND=0.0.0.0

# METRICS_PORT — default: 9464. Range 1–65535.
#   Equal to MCP_PORT while HTTP is on REFUSES TO START. A port already taken
#   fails the startup (exit 1), naming METRICS_PORT.
# METRICS_PORT=9464

# METRICS_TOKEN / METRICS_TOKEN_FILE — optional. A scrape-only bearer token.
#   Set it whenever the port is reachable from beyond this machine. At least 32
#   characters, and never another credential: one equal to BEARER_TOKEN,
#   IVANTI_API_KEY or IVANTI_CENTRAL_CONFIG_API_KEY refuses to start, because
#   whatever scrapes would then hold a key to the tools or the tenant.
#   Generate one:
#     openssl rand -base64 32
#   Prometheus sends it from its own copy of the file:
#     authorization: { credentials_file: /etc/prometheus/secrets/ivanti-mcp-metrics-token }
#   (`bearer_token_file` on older versions). These rules are judged only while
#   METRICS_ON=true.
# METRICS_TOKEN=<output of openssl rand -base64 32>
# METRICS_TOKEN_FILE=/run/secrets/metrics-token
