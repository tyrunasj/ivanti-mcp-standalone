# Both transports at once.
#
# STDIO_TRANSPORT_ON and HTTP_TRANSPORT_ON are independent toggles and both may
# be on; each transport then gets its own McpServer, because connect() binds one
# transport at a time. AUTH_MODE applies ONLY to HTTP — the stdio side is
# reached by running the process, and nothing about AUTH_MODE changes that.
#
# Useful when one machine serves a local desktop client and an internal listener
# at the same time. Both transports off is refused.

STDIO_TRANSPORT_ON=true
HTTP_TRANSPORT_ON=true

AUTH_MODE=bearer
BEARER_TOKEN_FILE=/run/secrets/bearer-token
MCP_BIND=127.0.0.1
MCP_PORT=3000
MCP_PUBLIC_URL=http://127.0.0.1:3000/mcp
TRUSTED_ORIGINS=http://localhost

MCP_MODE=full

IVANTI_BASE_URL=https://your-tenant.example.com
IVANTI_API_KEY=your-key
