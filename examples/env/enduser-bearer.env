# Self-service for employees, behind a shared token.
#
# ENDUSER_BUSINESS_OBJECTS is a GATE, not a hint: empty means none, and every
# name is resolved against the tenant at startup, so a misspelling exits 78 with
# suggestions rather than quietly narrowing what an end user may do.
#
# ENDUSER_QUICK_ACTIONS names the tenant's own procedures verbatim. They are the
# tenant's text and get renamed freely, so read them off list_quick_actions in a
# `full` deployment and copy the handful an end user should have. Never guess.

STDIO_TRANSPORT_ON=false
HTTP_TRANSPORT_ON=true

AUTH_MODE=bearer
BEARER_TOKEN_FILE=/run/secrets/bearer-token
MCP_BIND=0.0.0.0
MCP_PORT=3000
MCP_PUBLIC_URL=https://selfservice.example.com/mcp
TRUSTED_ORIGINS=https://mcp-client.example.com

MCP_MODE=enduser
ENDUSER_BUSINESS_OBJECTS=Incident,ServiceReq
ENDUSER_QUICK_ACTIONS=Close From Self Service

IVANTI_BASE_URL=https://your-tenant.example.com
IVANTI_API_KEY_FILE=/run/secrets/ivanti-api-key
