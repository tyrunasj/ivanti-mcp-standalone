# A shared internal service behind a static token.
#
# A bearer token grants this entire tool surface to everyone who can use the
# client holding it. Pair a widely-shared token with MCP_MODE=enduser instead —
# see enduser-bearer.env.
#
# Secrets take the _FILE form: `docker inspect` and /proc/<pid>/environ both show
# the environment, while a mounted secret shows only a path. Setting both forms
# of a secret is an error, not a precedence question.

STDIO_TRANSPORT_ON=false
HTTP_TRANSPORT_ON=true

AUTH_MODE=bearer
BEARER_TOKEN_FILE=/run/secrets/bearer-token
MCP_BIND=0.0.0.0
MCP_PORT=3000
MCP_PUBLIC_URL=https://mcp.example.com/mcp
TRUSTED_ORIGINS=https://mcp-client.example.com

MCP_MODE=full
MCP_MAX_SESSIONS=100
MCP_SESSION_IDLE_TTL_SECONDS=1800

IVANTI_BASE_URL=https://your-tenant.example.com
IVANTI_API_KEY_FILE=/run/secrets/ivanti-api-key
