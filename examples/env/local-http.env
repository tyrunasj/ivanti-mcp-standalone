# One machine, over HTTP, no authentication.
#
# MCP_BIND stays on loopback: the network is the boundary, and it is this host.
# AUTH_MODE=none on 0.0.0.0 would serve the whole tool surface to anything that
# can route to you — the server warns but will not stop you.

STDIO_TRANSPORT_ON=false
HTTP_TRANSPORT_ON=true

AUTH_MODE=none
MCP_BIND=127.0.0.1
MCP_PORT=3000
MCP_PUBLIC_URL=http://127.0.0.1:3000/mcp
TRUSTED_ORIGINS=http://localhost

MCP_MODE=full
LOG_LEVEL=debug

IVANTI_BASE_URL=https://your-tenant.example.com
IVANTI_API_KEY=your-key
