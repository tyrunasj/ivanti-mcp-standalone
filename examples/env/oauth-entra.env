# Enterprise SSO with Microsoft Entra ID — the only door carrying a verified
# user identity.
#
# OAUTH_AUDIENCE IS NOT MCP_PUBLIC_URL. No mainstream provider mints `aud` from
# the client's RFC 8707 resource parameter. For Entra it depends on the token
# version the app registration requests:
#   requestedAccessTokenVersion: 2  ->  aud is the API's client id, a bare GUID
#   v1.0 tokens                     ->  aud is the App ID URI, api://<appId>
# Putting the wrong one here yields a perfectly valid token this server refuses.
#
# Entra cannot be exercised against localhost: it requires `resource` to be a
# registered Application ID URI, and a conforming client requires it to equal
# the endpoint. Deploy to a public HTTPS name on a verified domain first.

STDIO_TRANSPORT_ON=false
HTTP_TRANSPORT_ON=true

AUTH_MODE=oauth
OAUTH_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
OAUTH_AUDIENCE=11111111-1111-1111-1111-111111111111
OAUTH_IDENTITY_CLAIM=preferred_username

MCP_BIND=0.0.0.0
MCP_PORT=3000
MCP_PUBLIC_URL=https://mcp.example.com/mcp
TRUSTED_ORIGINS=https://mcp-client.example.com

MCP_MODE=enduser
ENDUSER_BUSINESS_OBJECTS=Incident,ServiceReq
ENDUSER_QUICK_ACTIONS=Close From Self Service

IVANTI_BASE_URL=https://your-tenant.example.com
IVANTI_API_KEY_FILE=/run/secrets/ivanti-api-key
