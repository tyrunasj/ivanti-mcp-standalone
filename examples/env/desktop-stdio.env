# Desktop client over stdio — the default, and the smallest thing that works.
#
# No socket and no AUTH_MODE: the credential is the ability to run the process.
# Setting AUTH_MODE while HTTP is off is an error rather than a no-op, so it is
# absent here deliberately.

STDIO_TRANSPORT_ON=true
HTTP_TRANSPORT_ON=false

MCP_MODE=full

IVANTI_BASE_URL=https://your-tenant.example.com
IVANTI_API_KEY=your-key
