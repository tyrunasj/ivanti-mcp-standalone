# Self-service where Ivanti — not this server — decides what each person may see.
#
# The pair IVANTI_CONFIG_URL + IVANTI_CENTRAL_CONFIG_API_KEY turns act_as from a
# preference into an identity Ivanti enforces. Without them act_as only decides
# who "my" means, and every call still reaches the tenant as the service account.
# With them, act_as opens a session AS that person: a self-service role reads
# none of the incidents an analyst reads, and tickets they raise carry their name
# in CreatedBy rather than this account's.
#
# Every surface follows the person: records, forms, pick lists, quick actions,
# service requests and their attachments. Only tenant-wide facts — the schema,
# the admin catalog, the person directory — stay on the service account, because
# they describe the tenant rather than the person.
#
# Paired with AUTH_MODE=oauth deliberately. Impersonation works under any auth
# mode, but here the person is proven by their token rather than by a name the
# conversation supplied, so the attribution Ivanti records is as strong as the
# identity behind it. Under `bearer` or `none` the tenant's audit trail would
# still read as though that person acted directly.
#
# ENDUSER_ROLE names which self-service role the session opens under. Ivanti flags
# its self-service roles, but several qualify and they are not interchangeable.
# The default below is the role Ivanti ships for the mobile portal. It is resolved
# PER PERSON when `act_as` runs, not at startup: if this tenant renamed it, that
# call's `roleNote` says so and the session keeps whichever role Ivanti made
# active. Only ENDUSER_BUSINESS_OBJECTS is checked against the tenant at boot.

STDIO_TRANSPORT_ON=false
HTTP_TRANSPORT_ON=true

AUTH_MODE=oauth
OAUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OAUTH_IDENTITY_CLAIM=preferred_username
MCP_BIND=0.0.0.0
MCP_PORT=3000
MCP_PUBLIC_URL=https://selfservice.example.com/mcp
TRUSTED_ORIGINS=https://mcp-client.example.com

MCP_MODE=enduser
ENDUSER_BUSINESS_OBJECTS=Incident,ServiceReq
ENDUSER_QUICK_ACTIONS=Close From Self Service
ENDUSER_ROLE=SelfServiceMobile

IVANTI_BASE_URL=https://your-tenant.example.com
IVANTI_API_KEY_FILE=/run/secrets/ivanti-api-key

# Configure → Security Controls → API Keys → CentralConfigApiKey group, on the
# ConfigDB tenant. Not the tenant API key, and not interchangeable with it:
# CentralConfig answers this key with the tenant's database credentials.
IVANTI_CONFIG_URL=https://config-your-tenant.example.com
IVANTI_CENTRAL_CONFIG_API_KEY_FILE=/run/secrets/ivanti-central-config-key
