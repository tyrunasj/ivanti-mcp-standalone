# Reproducing what a customer without admin rights actually gets.
#
# IVANTI_MAX_TIER caps the server BELOW what the credential can do. It exists
# because the degraded paths cannot otherwise be exercised: Ivanti's
# AuthenticateTenantAPIKey ignores its own `role` argument, so an admin account
# asking for SelfService still comes back as Admin. Cap the server instead.
#
#   odata    the API key alone — every read tool, objects from metadata graphs
#   session  + the ASMX handshake — identity, picklists, quick actions
#   admin    + the admin console — the complete catalogue
#
# get_pick_list_values is the first tool the tier actually gates: it needs a
# create form, which OData cannot see.

STDIO_TRANSPORT_ON=true
HTTP_TRANSPORT_ON=false

MCP_MODE=full
IVANTI_MAX_TIER=session
LOG_LEVEL=debug

IVANTI_BASE_URL=https://your-tenant.example.com
IVANTI_API_KEY=your-key
