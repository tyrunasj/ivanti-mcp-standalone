# Enterprise SSO with Keycloak — the least troublesome of the mainstream
# providers: JWTs by default, PKCE advertised, dynamic registration supported.
#
# The one non-obvious step is server-side, not here: by default Keycloak puts
# `account` in `aud`, not your client id, so audience validation fails on an
# otherwise perfect token. Add an Audience mapper on the client's dedicated
# scope, with "Add to access token" on.
#
# OAUTH_JWKS_URI is set explicitly, which skips discovery entirely. Leave it out
# to let the server discover from OAUTH_ISSUER in the spec's probe order.

STDIO_TRANSPORT_ON=false
HTTP_TRANSPORT_ON=true

AUTH_MODE=oauth
OAUTH_ISSUER=https://sso.example.com/realms/corp
OAUTH_AUDIENCE=ivanti-mcp
OAUTH_JWKS_URI=https://sso.example.com/realms/corp/protocol/openid-connect/certs
OAUTH_IDENTITY_CLAIM=email
OAUTH_SCOPES_SUPPORTED=openid,profile,email

MCP_BIND=0.0.0.0
MCP_PORT=3000
MCP_PUBLIC_URL=https://mcp.example.com/mcp
TRUSTED_ORIGINS=https://mcp-client.example.com

MCP_MODE=full

IVANTI_BASE_URL=https://your-tenant.example.com
IVANTI_API_KEY_FILE=/run/secrets/ivanti-api-key
